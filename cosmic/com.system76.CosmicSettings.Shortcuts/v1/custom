    (
        modifiers: [],
        key: "XF86Display",
        description: Some("Display Settings"),
    ): Spawn("nwg-displays"),

    # HP programmable key
    (
        modifiers: [],
        key: "XF86Launch8",
        description: Some("VPN"),
    ): Spawn("bash /home/patrik/.config/hypr/scripts/vpn.sh"),


    # =========================================================
    # EVOFOX FireBlade
    # =========================================================

    # Tools key
    (
        modifiers: [],
        key: "XF86Tools",
        description: Some("Online Music"),
    ): Spawn("/home/patrik/.config/hypr/UserScripts/RofiBeats.sh"),

    # Calculator key — EVOFOX reports this as XF86AudioStop
