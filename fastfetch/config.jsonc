{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/fedora.png",
        "width": 24,
        "height": 12,
        "padding": {
            "right": 3
        }
    },

    "display": {
        "separator": "  →  "
    },

    "modules": [
        "title",
        "separator",

        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",

        "cpu",
        "gpu",
        "memory"
    ]
}


