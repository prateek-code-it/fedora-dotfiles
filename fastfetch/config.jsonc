{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/patrik/.config/fastfetch/cat.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "format": "Hey, {1}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500 Hardware \u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "memory",
      "key": "RAM"
    },
    {
      "type": "disk",
      "key": "DRIVE"
    },
    "break",
    {
      "type": "custom",
      "format": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500 Software \u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "shell",
      "key": "SHELL"
    },
    {
      "type": "terminal",
      "key": "TERM"
    },
    "break",
    {
      "type": "uptime",
      "key": "UPTIME"
    }
  ]
}