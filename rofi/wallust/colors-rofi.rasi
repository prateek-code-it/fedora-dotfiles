 /* wallust template - colors-rofi */

* {
active-background: #7D8FBC;
active-foreground: #F6F0E7;
normal-background: #1A1919;
normal-foreground: #F6F0E7;
urgent-background: #E19A41;
urgent-foreground: #F6F0E7;

alternate-active-background: #214C9C;
alternate-active-foreground: #F6F0E7;
alternate-normal-background: #1A1919;
alternate-normal-foreground: #F6F0E7;
alternate-urgent-background: #1A1919;
alternate-urgent-foreground: #F6F0E7;

selected-active-background: #7D8FBC;
selected-active-foreground: #1A1919;
selected-normal-background: #7D8FBC;
