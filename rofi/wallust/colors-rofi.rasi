urgent-background: #A09988;
urgent-foreground: #F6DED1;

alternate-active-background: #519296;
alternate-active-foreground: #F6DED1;
alternate-normal-background: #111215;
alternate-normal-foreground: #F6DED1;
alternate-urgent-background: #111215;
alternate-urgent-foreground: #F6DED1;

