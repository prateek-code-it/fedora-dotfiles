{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-window-width": 380,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 420,
  "control-center-height": 700,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "dnd",
    "title",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃟"
    },
    "buttons-grid": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰐥",
          "tooltip": "Power Menu",
          "type": "button",
          "command": "$HOME/.config/hypr/scripts/Wlogout.sh"
        },
        {
          "label": "",
          "tooltip": "Lock Screen",
          "type": "button",
          "command": "hyprlock"
        },
        {
          "label": "󰤨",
          "tooltip": "Wi-Fi Settings",
          "type": "button",
          "command": "$HOME/.config/hypr/scripts/RofiWifi.sh"
        },
        {
          "label": "󰖂",
          "tooltip": "Cloudflare WARP VPN",
          "type": "button",
          "command": "sh -c 'if warp-cli status | grep -q Connected; then warp-cli disconnect; else warp-cli connect; fi'"
        },
        {
          "label": "󰂯",
          "tooltip": "Bluetooth Settings",
          "type": "button",
          "command": "$HOME/.config/hypr/scripts/RofiBluetooth.sh"
        },
        {
          "label": "",
          "tooltip": "Spotify",
          "type": "button",
          "command": "spotify || flatpak run com.spotify.Client"
        },
        {
          "label": "󰎆",
          "tooltip": "RofiBeats",
          "type": "button",
          "command": "$HOME/.config/hypr/UserScripts/RofiBeats.sh"
        },
        {
          "label": "󰌌",
          "tooltip": "On-Screen Keyboard",
          "type": "button",
          "command": "sh ~/.config/hypr/UserScripts/toggle-osk.sh"
        },
        {
          "label": "󰈈",
          "tooltip": "HP Sure View (Privacy Screen)",
          "type": "button",
          "command": "brightnessctl -d 'hp_privacy_screen' set 1+!"
        }
      ]
    }
  }
}
